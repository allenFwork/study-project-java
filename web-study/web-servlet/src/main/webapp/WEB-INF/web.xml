<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- 上下文参数 servletContext (开始) -->
    <context-param>
        <param-name>contextFirstParameter</param-name>
        <param-value>contextFirstParameterValue</param-value>
        <!--<description>this is the first parameter.</description>-->
    </context-param>
    <!-- 上下文参数 servletContext (结束) -->

    <!-- servlet(开始) -->
    <servlet>
        <servlet-name>helloServlet</servlet-name>
        <servlet-class>com.study.servlet.HelloServlet</servlet-class>
        <!-- servletConfig配置 -->
        <init-param>
            <param-name>servletFirstParameter</param-name>
            <param-value>servletFirstParameterValue</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>helloServlet</servlet-name>
        <url-pattern>/hello.do</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>goodByeServlet</servlet-name>
        <servlet-class>com.study.servlet.GoodByeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>goodByeServlet</servlet-name>
        <url-pattern>/goodbye</url-pattern>
    </servlet-mapping>

    <!-- servlet的生命周期测试 -->
    <servlet>
        <servlet-name>servletLifeCycle</servlet-name>
        <servlet-class>com.study.servlet.LifeCycleServlet</servlet-class>
        <!-- servletConfig配置（开始） -->
        <init-param>
            <param-name>superman</param-name>
            <param-value> can fly </param-value>
        </init-param>
        <init-param>
            <param-name>batman</param-name>
            <param-value> can fight </param-value>
        </init-param>
        <!-- servletConfig配置（结束） -->
        <!-- 添加了 load-on-startup 为 1 的配置后，容器初始化的时候就会创建该servlet对象实例，并进行初始化-->
        <!--<load-on-startup>1</load-on-startup>-->
    </servlet>
    <servlet-mapping>
        <servlet-name>servletLifeCycle</servlet-name>
        <url-pattern>/servletLifeCycle</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>servletContext</servlet-name>
        <servlet-class>com.study.servlet.ServletContextServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>servletContext</servlet-name>
        <url-pattern>/servletContext</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>servletContext2</servlet-name>
        <servlet-class>com.study.servlet.ServletContextServlet2</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>servletContext2</servlet-name>
        <url-pattern>/servletContext2</url-pattern>
    </servlet-mapping>

    <!-- 配置错误处理页面 -->
    <error-page>
        <exception-type>javax.servlet.ServletException</exception-type>
        <location>/error.jsp</location>
    </error-page>
    <servlet>
        <servlet-name>exceptionServlet</servlet-name>
        <servlet-class>com.study.servlet.ExceptionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>exceptionServlet</servlet-name>
        <url-pattern>/exceptionServlet</url-pattern>
    </servlet-mapping>
    
    <!-- cookie的处理 -->
    <servlet>
        <servlet-name>cookieServlet</servlet-name>
        <servlet-class>com.study.servlet.CookieServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>cookieServlet</servlet-name>
        <url-pattern>/cookieServlet</url-pattern>
    </servlet-mapping>

    <!-- session的处理 -->
    <servlet>
        <servlet-name>sessionServlet</servlet-name>
        <servlet-class>com.study.servlet.SessionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>sessionServlet</servlet-name>
        <url-pattern>/sessionServlet</url-pattern>
    </servlet-mapping>

    <!--<servlet>
      <servlet-name>wordChangeHtml</servlet-name>
      <servlet-class>com.study.servlet.WordChangeToServlet</servlet-class>
    </servlet>
    <servlet-mapping>
      <servlet-name>wordChangeHtml</servlet-name>
      <url-pattern>/wordToHtml</url-pattern>
    </servlet-mapping>-->
    <!-- servlet(结束) -->

    <!--&lt;!&ndash; 过滤器:Filter &ndash;&gt;-->
    <!--<filter>-->
    <!--<filter-name>FirstFilter</filter-name>-->
    <!--<filter-class>com.study.</filter-class>-->
    <!--</filter>-->

</web-app>