<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>

    <!-- context用于指定生成一组对象的环境：指定要连接的数据库，要生成对象的类型和要处理的数据库中的表。 -->
    <!-- context的属性：
           1. id 必选属性，用来唯一确定一个<context>元素；
           2. defaultModelType 可选属性，用来定义了MBG如何生成实体类
              2.1 conditional， 默认值，除了如果那个单独的类将只包含一个字段，将不会生成一个单独的类。
                                因此,如果一个表的主键只有一个字段,那么不会为该字段生成单独的实体类,会将该字段合并到基本实体类中。
              2.2 flat，        为每一张表只生成一个实体类。这个实体类包含表中的所有字段。
              2.3 hierarchical，如果表有主键,那么该模型会产生一个单独的主键实体类，如果表还有BLOB字段，则会为表生成一个包含所有BLOB字段的单独的实体类，
                                然后为所有其他的字段生成一个单独的实体类。 MBG会在所有生成的实体类之间维护一个继承关系。
           3. targetRuntime 可选属性，用于指定生成的代码的运行时环境
              3.1 MyBatis3，      默认值
              3.2 MyBatis3Simple
              3.3 Ibatis2Java2
              3.4 Ibatis2Java5
           4. introspectedColumnImpl 可选属性
    -->
    <context id="MysqlTables" targetRuntime="MyBatis3">

        <!-- commentGenerator：用来控制生成的代码中可以包含注释信息，具体就是生成表或字段的备注信息。 -->
        <commentGenerator>
            <!-- 是否阻止生成的注释包含时间戳, true: 是；false：否 -->
            <property name="suppressDate" value="true"/>
            <!-- 是否去除自动生成的注释 true：是 ： false:否 -->
            <property name="suppressAllComments" value="true"/>
        </commentGenerator>

        <!-- jdbc连接信息 -->
        <!-- oracle数据库连接配置 -->
        <!--<jdbcConnection driverClass="oracle.jdbc.driver.OracleDriver"
                        connectionURL="jdbc:oracle:thin:@localhost:1521/数据库名字"
                        userId=""
                        password="">
        </jdbcConnection>-->
        <!-- mysql数据库连接配置 -->
        <!--<jdbcConnection driverClass="com.mysql.jdbc.Driver"
                        connectionURL="jdbc:mysql://localhost:3307/orders_0?serverTimezone=GMT%2B8"
                        userId="root"
                        password="">
        </jdbcConnection>-->
        <!-- SqlServer数据库连接配置 -->
        <jdbcConnection driverClass="com.microsoft.sqlserver.jdbc.SQLServerDriver"
                        connectionURL="jdbc:sqlserver://10.110.147.31:1433;DatabaseName=Lecoo"
                        userId="sa"
                        password="zhangyh33!">
        </jdbcConnection>

        <!--
             javaTypeResolver：用来指定JDBC类型和Java类型如何转换，默认false，把JDBC DECIMAL 和 NUMERIC 类型解析为 Integer，
                               为true时，把JDBC DECIMAL 和 NUMERIC 类型解析为java.math.BigDecimal
        -->
        <javaTypeResolver>
            <property name="forceBigDecimals" value="false"/>
        </javaTypeResolver>

        <!-- javaModelGenerator：用来控制生成的实体类，生成PO类的位置 -->
        <!--  -->
        <javaModelGenerator targetPackage="com.study.mapper.lec2.entity"
                            targetProject="src/main/java">
            <!-- enableSubPackages: 是否让schema作为包的后缀 -->
            <property name="enableSubPackages" value="true"/>
            <!-- 从数据库返回的值被清理前后的空格 -->
            <property name="trimStrings" value="true"/>
        </javaModelGenerator>

        <!-- mapper映射文件生成的位置 -->
        <sqlMapGenerator targetPackage="com.study.mapper.lec2.interfaces"
                         targetProject="src/main/java">
            <!-- enableSubPackages:是否让schema作为包的后缀 -->
            <property name="enableSubPackages" value="true"/>
        </sqlMapGenerator>

        <!-- mapper接口生成的位置 -->
        <javaClientGenerator type="XMLMAPPER"
                             targetPackage="com.study.mapper.lec2.interfaces"
                             targetProject="src/main/java">
            <!-- enableSubPackages:是否让schema作为包的后缀 -->
            <property name="enableSubPackages" value="true"/>
        </javaClientGenerator>


        <!-- table：用来指定要生成的表 -->
        <!-- table属性：
                1. tableName，必选属性，指定要生成的表名，可以使用SQL通配符匹配多个表。
                2. schema，数据库的schema，可以使用SQL通配符匹配。如果设置了该值，生成SQL的表名会变成如schema.tableName的形式。
                3. alias，
         -->
        <!--<table schema="" tableName="student">
            &lt;!&ndash;<property name="useActualColumnNames" value="true"/>&ndash;&gt;
            &lt;!&ndash;<generatedKey column="id" sqlStatement="MySql" identity="true"/>&ndash;&gt;
        </table>-->
        <table tableName="LENOVO_SKUJCSJ_SPKC_java"
               enableCountByExample="false"
               enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="false"
               selectByExampleQueryId="false">
        </table>
        <!--<table tableName="target_time_line_data_lecoo" domainObjectName="TargetTimeLineDataLeccoDO"
               enableCountByExample="false"
               enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="false"
               selectByExampleQueryId="false">
        </table>-->
        <!--<table tableName="%"
               enableCountByExample="false"
               enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="false"
               selectByExampleQueryId="false">
        </table>-->

    </context>

</generatorConfiguration>