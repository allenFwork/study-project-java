<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd"
default-lazy-init="true">

    <!-- 默认构造方法构建 -->
    <bean id="springHello" class="com.study.entity.HelloSpring"></bean>

    <!-- 指定构造方法构建 -->
    <bean class="com.study.entity.HelloSpring">
        <constructor-arg index="0" value="superman"/>
        <constructor-arg name="sex" value="1"/>
    </bean>

    <!-- 静态工厂方法创建 -->
    <bean class="com.study.entity.HelloSpring" factory-method="build">
        <constructor-arg name="type" value="A"></constructor-arg>
    </bean>

    <bean id="driver" class="com.study.entity.DriverFactoryBean">
        <property name="jdbcUrl" value="jdbc:mysql://localhost:3306"></property>
    </bean>

    <!--
        自动注入：
          byType：通过类型注入
          byName：通过bean对象的id注入
          default：使用 beans 中的 default-autowire 的配置
     -->
    <bean class="com.study.entity.Hi" primary="true"></bean>
    <bean class="com.study.entity.HelloSpring" autowire="byType"></bean>
    <bean class="com.study.entity.HelloSpring" autowire="byName"></bean>
    <bean class="com.study.entity.HelloSpring" autowire="default"></bean>


    <bean class="com.study.entity.SingleBean1">
        <!-- 通过lookup-method获取抽象方法返回的实例对象 -->
        <lookup-method name="getHi"></lookup-method>
    </bean>

    <bean id="hi" class="com.study.entity.Hi" name="hi2"></bean>
</beans>